# Module 3 Cortex lab only. Copy this file to .env and paste your key.
# Never commit .env. Module 1 does not use this file.
#
# Layers 1 and 2, the trajectory eval, and the kappa math run with no key.
# Only the Layer 3 judge reads OPENAI_API_KEY.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini inside eval_lab.ipynb.
EVAL_MODEL=gpt-4o-mini
